# Copy to .env.local for local development. Set the same values in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Staff login (required for /login and /dashboard to work)
# SESSION_SECRET: random string, at least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=
# Owner/admin password, at least 8 characters (use a long passphrase)
ADMIN_PASSWORD=
# Shared technician password, at least 8 characters (optional; technician login is disabled if empty)
TECH_PASSWORD=

# Supabase (needed for the employee records pages)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Aadhaar encryption: 32-byte key as 64-char hex. Generate: openssl rand -hex 32
AADHAAR_ENCRYPTION_KEY=
